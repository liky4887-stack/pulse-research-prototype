{
  "expo": {
    "name": "Pulse Research Prototype",
    "slug": "pulse-research-prototype",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "pulseresearch",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": null
    },
    "plugins": [
      "expo-router",
      "expo-splash-screen",
      "expo-status-bar",
      [
        "react-native-vision-camera",
        {
          "cameraPermissionText": "Pulse Research Prototype needs camera access to measure your pulse locally, on-device only.",
          "enableMicrophonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
